<!--
  Test fixture: minimal base config for merge testing.
  Schema 4.50. Has one RuleGroup so we can verify the merge appends correctly.
-->
<Sysmon schemaversion="4.50">
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  <CheckRevocation>True</CheckRevocation>
  <EventFiltering>
    <RuleGroup name="ProcessCreate-Base" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image name="exclude=base config noise" condition="is">C:\Windows\System32\conhost.exe</Image>
      </ProcessCreate>
    </RuleGroup>
  </EventFiltering>
</Sysmon>
