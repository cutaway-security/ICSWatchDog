<Sysmon schemaversion="4.50">
  <HashAlgorithms>md5,sha256,IMPHASH</HashAlgorithms>
  <CheckRevocation>True</CheckRevocation>
  <EventFiltering>
    <RuleGroup name="ProcessCreate-Base" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <Image name="exclude=base config noise" condition="is">C:\Windows\System32\conhost.exe</Image>
      </ProcessCreate>
    </RuleGroup>
  <RuleGroup name="NetworkConnect-Test-Modbus" groupRelation="or">
  <NetworkConnect onmatch="include">
    <DestinationPort name="technique_id=T0830,technique=Adversary-in-the-Middle,detection=test Modbus port 502" condition="is">502</DestinationPort>
  </NetworkConnect>
</RuleGroup>
</EventFiltering>
</Sysmon>