<!--
  ICS Watch Dog Module: Persistence via LOLBAS
  Category:     lolbas
  Version:      v1.0
  Schema:       4.50
  Dependencies: none
  ATT&CK:       T1547.001 Registry Run Keys, T1053.005 Scheduled Task,
                T1543.003 Windows Service, T1546.012 IFEO

  PURPOSE:
    Detect persistence mechanism establishment via signed Windows binaries.
    These detections fire on the COMMAND-LINE invocation of persistence tools,
    complementing the registry/file detection in the curated configs.

  WHEN TO USE:
    Any environment that wants to detect interactive persistence creation
    (typically via cmd.exe or powershell.exe child processes invoking these
    tools to install autostart entries).

  FALSE POSITIVE RISK:
    Moderate. Admin scripts and software installers legitimately create
    scheduled tasks, services, and Run keys. Tune by excluding installer
    parent processes (msiexec, setup.exe, etc.).

  REFERENCES:
    https://attack.mitre.org/techniques/T1547/001/
    https://attack.mitre.org/techniques/T1053/005/
    https://attack.mitre.org/techniques/T1543/003/
-->
<RuleGroup name="ProcessCreate-LOLBAS-Persistence" groupRelation="or">
  <ProcessCreate onmatch="include">
    <!-- T1053.002 At - Deprecated scheduler, rare on modern systems -->
    <Image name="technique_id=T1053.002,technique=At,detection=at.exe deprecated scheduler execution" condition="end with">\at.exe</Image>
    <!-- T1053.005: schtasks /create /sc onstart -->
    <Rule name="technique_id=T1053.005,technique=Scheduled Task,detection=schtasks creating onstart scheduled task" groupRelation="and">
      <Image condition="end with">\schtasks.exe</Image>
      <CommandLine condition="contains all">/create;/sc onstart</CommandLine>
    </Rule>
    <!-- T1053.005: schtasks /create /sc onlogon -->
    <Rule name="technique_id=T1053.005,technique=Scheduled Task,detection=schtasks creating onlogon scheduled task" groupRelation="and">
      <Image condition="end with">\schtasks.exe</Image>
      <CommandLine condition="contains all">/create;/sc onlogon</CommandLine>
    </Rule>
    <!-- T1053.005: schtasks /create /ru SYSTEM -->
    <Rule name="technique_id=T1053.005,technique=Scheduled Task,detection=schtasks creating SYSTEM-context task" groupRelation="and">
      <Image condition="end with">\schtasks.exe</Image>
      <CommandLine condition="contains all">/create;/ru system</CommandLine>
    </Rule>
    <!-- T1053.005: schtasks /create with /xml argument (XML-based task definition) -->
    <Rule name="technique_id=T1053.005,technique=Scheduled Task,detection=schtasks creating task from XML definition" groupRelation="and">
      <Image condition="end with">\schtasks.exe</Image>
      <CommandLine condition="contains all">/create;/xml</CommandLine>
    </Rule>
    <!-- T1543.003: sc create with binPath -->
    <Rule name="technique_id=T1543.003,technique=Windows Service,detection=sc create new service with binary path" groupRelation="and">
      <Image condition="end with">\sc.exe</Image>
      <CommandLine condition="contains all">create;binpath</CommandLine>
    </Rule>
    <!-- T1543.003: sc config to change service binary -->
    <Rule name="technique_id=T1543.003,technique=Windows Service,detection=sc config modifying service binary path" groupRelation="and">
      <Image condition="end with">\sc.exe</Image>
      <CommandLine condition="contains all">config;binpath</CommandLine>
    </Rule>
    <!-- T1547.001: reg add Run key from cmd or powershell -->
    <Rule name="technique_id=T1547.001,technique=Registry Run Keys / Startup Folder,detection=reg add to autostart Run key from CLI" groupRelation="and">
      <Image condition="end with">\reg.exe</Image>
      <CommandLine condition="contains all">add;\currentversion\run</CommandLine>
    </Rule>
    <!-- T1547.001: reg add RunOnce -->
    <Rule name="technique_id=T1547.001,technique=Registry Run Keys / Startup Folder,detection=reg add to autostart RunOnce key from CLI" groupRelation="and">
      <Image condition="end with">\reg.exe</Image>
      <CommandLine condition="contains all">add;\currentversion\runonce</CommandLine>
    </Rule>
    <!-- T1546.012: reg add Image File Execution Options -->
    <Rule name="technique_id=T1546.012,technique=Image File Execution Options Injection,detection=reg add to IFEO from CLI" groupRelation="and">
      <Image condition="end with">\reg.exe</Image>
      <CommandLine condition="contains all">add;image file execution options</CommandLine>
    </Rule>
  </ProcessCreate>
</RuleGroup>
