<!--
  ICS Watch Dog Module: Oil and Gas Pipeline
  Category:     sector
  Version:      v1.0
  Schema:       4.50
  Dependencies: none
  ATT&CK:       T0830 Adversary-in-the-Middle, T0855 Unauthorized Command Message

  PURPOSE:
    Add oil and gas pipeline-specific monitoring. Pipeline operators commonly use
    Modbus TCP, DNP3, OPC-UA, and HART-IP for SCADA communications, plus the
    AVEVA PI System or OSIsoft historian for measurement data.

  WHEN TO USE:
    Engineering workstations, control centers, and metering systems for upstream,
    midstream, and downstream oil and gas operations.

  RELEVANT REGULATIONS:
    TSA Pipeline Security Directive SD02-2021-01 (and successors)
    API 1164 Pipeline SCADA Security

  REFERENCES:
    https://www.tsa.gov/news/press/releases/2022/07/21/tsa-updates-renews-cybersecurity-requirements-pipeline-owners
    https://www.api.org/oil-and-natural-gas/health-and-safety/security/cybersecurity
-->
<RuleGroup name="NetworkConnect-OilGas-Pipeline" groupRelation="or">
  <NetworkConnect onmatch="include">
    <!--
      T0830 Adversary-in-the-Middle (ICS) + T0855 Unauthorized Command Message (ICS)
      Oil and gas pipeline industrial protocols.
    -->
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to Modbus TCP port 502" condition="is">502</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to DNP3 port 20000" condition="is">20000</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to OPC-UA port 4840" condition="is">4840</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to HART-IP port 5094" condition="is">5094</DestinationPort>
    <DestinationPort name="technique_id=T0830,technique=Adversary-in-the-Middle,detection=Process connecting to OSIsoft PI port 5450" condition="is">5450</DestinationPort>
  </NetworkConnect>
</RuleGroup>
