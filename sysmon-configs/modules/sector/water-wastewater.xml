<!--
  ICS Watch Dog Module: Water and Wastewater
  Category:     sector
  Version:      v1.0
  Schema:       4.50
  Dependencies: none
  ATT&CK:       T0830 Adversary-in-the-Middle, T0855 Unauthorized Command Message

  PURPOSE:
    Add water/wastewater utility-specific monitoring. The sector commonly uses
    Modbus TCP, DNP3, and BACnet (for facility automation). Water utilities have
    been targeted in multiple high-profile incidents (Oldsmar 2021, Aliquippa 2023).

  WHEN TO USE:
    Engineering workstations and HMIs at water treatment plants, wastewater
    treatment plants, distribution SCADA systems, and remote pump stations.

  RELEVANT REGULATIONS:
    America's Water Infrastructure Act (AWIA)
    EPA cybersecurity guidance for water systems

  REFERENCES:
    https://www.cisa.gov/news-events/cybersecurity-advisories/aa24-060a
-->
<RuleGroup name="NetworkConnect-Water-Wastewater" groupRelation="or">
  <NetworkConnect onmatch="include">
    <!--
      T0830 Adversary-in-the-Middle (ICS) + T0855 Unauthorized Command Message (ICS)
      Water/wastewater industrial protocols. References:
        https://attack.mitre.org/techniques/T0830/
        https://attack.mitre.org/techniques/T0855/
    -->
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to Modbus TCP port 502" condition="is">502</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to DNP3 port 20000" condition="is">20000</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to BACnet/IP port 47808" condition="is">47808</DestinationPort>
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to EtherNet/IP TCP port 44818" condition="is">44818</DestinationPort>
  </NetworkConnect>
</RuleGroup>

<RuleGroup name="ProcessCreate-Water-Wastewater" groupRelation="or">
  <ProcessCreate onmatch="include">
    <!--
      T1219 Remote Access Software
      The 2021 Oldsmar water treatment incident involved unauthorized remote access
      via TeamViewer. Water utilities should monitor RMM tools especially closely.
      Reference: https://attack.mitre.org/techniques/T1219/
    -->
    <Image name="technique_id=T1219,technique=Remote Access Software,detection=TeamViewer execution on water utility system" condition="end with">\TeamViewer.exe</Image>
  </ProcessCreate>
</RuleGroup>
