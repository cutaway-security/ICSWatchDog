<!--
  ICS Watch Dog Module: Mozilla Firefox (noise reduction)
  Category:     vendor-it
  Version:      v1.1
  Schema:       4.50
  Dependencies: none
  Rule type:    Exclude (noise reduction)

  PURPOSE:
    Suppress Sysmon event noise from sanctioned Mozilla Firefox browser usage.

  WHEN TO USE:
    Firefox is sanctioned at your site AND its event volume is overwhelming
    your monitoring pipeline.
  PROVENANCE:
    Source:           Mozilla Firefox default install paths from vendor documentation;
                      common deployment knowledge
    Confidence:       vendor-documented
    Last Validated:   2026-04-07 (initial draft, NOT lab-tested)
    Validated By:     unvalidated
    Known Limitations: Default install paths assumed. Custom or per-machine
                      installs in non-default paths will not match. Vendor may
                      change install paths in future versions. Excludes are noise
                      reduction; verify your environment actually has the volume
                      problem before merging this module.
-->
<RuleGroup name="NetworkConnect-Exclude-Firefox" groupRelation="or">
  <NetworkConnect onmatch="exclude">
    <Image name="exclude=Mozilla Firefox browser network" condition="end with">\Mozilla Firefox\firefox.exe</Image>
  </NetworkConnect>
</RuleGroup>

<RuleGroup name="DnsQuery-Exclude-Firefox" groupRelation="or">
  <DnsQuery onmatch="exclude">
    <Image name="exclude=Mozilla Firefox browser DNS noise" condition="end with">\Mozilla Firefox\firefox.exe</Image>
  </DnsQuery>
</RuleGroup>
