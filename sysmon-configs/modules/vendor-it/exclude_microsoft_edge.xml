<!--
  ICS Watch Dog Module: Microsoft Edge (noise reduction)
  Category:     vendor-it
  Version:      v1.1
  Schema:       4.50
  Dependencies: none
  Copyright:    (c) 2024-2026 Cutaway Security, LLC
  License:      CC BY-SA 4.0 | Commercial licensing available (info@cutawaysecurity.com)
  Rule type:    Exclude (noise reduction)

  PURPOSE:
    Suppress Sysmon event noise from sanctioned Microsoft Edge browser usage.
    Edge is included in modern Windows installations and is commonly used in
    OT environments for vendor portal access and documentation lookup.

  WHEN TO USE:
    Edge is sanctioned at your site AND its event volume is overwhelming
    your monitoring pipeline.
  PROVENANCE:
    Source:           Microsoft Edge default install paths from vendor documentation;
                      common deployment knowledge
    Confidence:       vendor-documented
    Last Validated:   2026-04-07 (initial draft, NOT lab-tested)
    Validated By:     unvalidated
    Known Limitations: Default install paths assumed. Custom or per-machine
                      installs in non-default paths will not match. Vendor may
                      change install paths in future versions. Excludes are noise
                      reduction; verify your environment actually has the volume
                      problem before merging this module.
-->
<RuleGroup name="NetworkConnect-Exclude-Edge" groupRelation="or">
  <NetworkConnect onmatch="exclude">
    <Image name="exclude=Microsoft Edge browser network" condition="end with">\Microsoft\Edge\Application\msedge.exe</Image>
  </NetworkConnect>
</RuleGroup>

<RuleGroup name="DnsQuery-Exclude-Edge" groupRelation="or">
  <DnsQuery onmatch="exclude">
    <Image name="exclude=Microsoft Edge browser DNS noise" condition="end with">\Microsoft\Edge\Application\msedge.exe</Image>
  </DnsQuery>
</RuleGroup>
