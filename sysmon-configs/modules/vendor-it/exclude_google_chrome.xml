<!--
  ICS Watch Dog Module: Google Chrome (noise reduction)
  Category:     vendor-it
  Version:      v1.1
  Schema:       4.50
  Dependencies: none
  Copyright:    (c) 2024-2026 Cutaway Security, LLC
  License:      CC BY-SA 4.0 | Commercial licensing available (info@cutawaysecurity.com)
  Rule type:    Exclude (noise reduction)

  PURPOSE:
    Suppress Sysmon event noise from sanctioned Google Chrome browser usage on
    OT engineering workstations and IT systems where Chrome is approved for
    accessing vendor portals, documentation, and web-based ICS dashboards.

  WHEN TO USE:
    Chrome is sanctioned at your site AND its event volume is overwhelming
    your monitoring pipeline.

  WHEN NOT TO USE:
    Chrome is not approved for OT use and you want to detect its presence as
    an unauthorized application. In that case, do not merge this module and
    let the baseline catch Chrome execution.

  TUNING NOTE:
    These exclusions reduce noise but do not blind you to Chrome process tree
    activity. ProcessCreate events for Chrome child processes still fire unless
    you also exclude chrome.exe from ProcessCreate (not done here, since the standard
    chrome process tree is forensically valuable).
  PROVENANCE:
    Source:           Google Chrome default install paths from vendor documentation;
                      common deployment knowledge
    Confidence:       vendor-documented
    Last Validated:   2026-04-07 (initial draft, NOT lab-tested)
    Validated By:     unvalidated
    Known Limitations: Default install paths assumed. Custom or per-machine
                      installs in non-default paths will not match. Vendor may
                      change install paths in future versions. Excludes are noise
                      reduction; verify your environment actually has the volume
                      problem before merging this module.
-->
<RuleGroup name="NetworkConnect-Exclude-Chrome" groupRelation="or">
  <NetworkConnect onmatch="exclude">
    <Image name="exclude=Google Chrome browser network" condition="end with">\Chrome\Application\chrome.exe</Image>
  </NetworkConnect>
</RuleGroup>

<RuleGroup name="DnsQuery-Exclude-Chrome" groupRelation="or">
  <DnsQuery onmatch="exclude">
    <Image name="exclude=Google Chrome browser DNS noise" condition="end with">\Chrome\Application\chrome.exe</Image>
  </DnsQuery>
</RuleGroup>

<RuleGroup name="FileCreateTime-Exclude-Chrome" groupRelation="or">
  <FileCreateTime onmatch="exclude">
    <Image name="exclude=Google Chrome timestamp updates" condition="end with">\Chrome\Application\chrome.exe</Image>
  </FileCreateTime>
</RuleGroup>
