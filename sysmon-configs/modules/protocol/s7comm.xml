<!--
  ICS Watch Dog Module: Siemens S7comm / ISO-TSAP
  Category:     protocol
  Version:      v1.0
  Schema:       4.50
  Dependencies: none
  ATT&CK:       T0830 Adversary-in-the-Middle, T0855 Unauthorized Command Message

  PURPOSE:
    Monitor process connections to Siemens S7comm port 102 (ISO-TSAP). Used by
    Siemens S7-300, S7-400, S7-1200, and S7-1500 PLCs for engineering and HMI
    communication.

  REFERENCES:
    https://attack.mitre.org/techniques/T0830/
-->
<RuleGroup name="NetworkConnect-S7comm" groupRelation="or">
  <NetworkConnect onmatch="include">
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to S7comm/ISO-TSAP port 102" condition="is">102</DestinationPort>
  </NetworkConnect>
</RuleGroup>
