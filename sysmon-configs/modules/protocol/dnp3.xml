<!--
  ICS Watch Dog Module: DNP3
  Category:     protocol
  Version:      v1.1
  Schema:       4.50
  Dependencies: none
  Copyright:    (c) 2024-2026 Cutaway Security, LLC
  License:      CC BY-SA 4.0 | Commercial licensing available (info@cutawaysecurity.com)
  ATT&CK:       T0830 Adversary-in-the-Middle, T0855 Unauthorized Command Message

  PURPOSE:
    Monitor process connections to DNP3 default port 20000. DNP3 is widely used
    in electric utility, water/wastewater, and oil and gas SCADA systems.

  REFERENCES:
    https://attack.mitre.org/techniques/T0830/
  PROVENANCE:
    Source:           IANA service name and port number registry; IEC and ISO
                      standards documents; protocol vendor specifications
    Confidence:       vendor-documented
    Last Validated:   2026-04-07
    Validated By:     unvalidated (port assignments are stable; vendor-documented
                      means the IANA/standards-body assignment is the source)
    Known Limitations: Default IANA-registered ports only. Custom port deployments
                      will not match (e.g., a Modbus TCP slave on port 5020 instead
                      of 502). Sysmon detects process-to-port; protocol payload
                      inspection requires a network IDS. Encrypted variants (e.g.,
                      OPC-UA over TLS, Modbus Security) appear identical at the
                      port level. Add site-specific ports for non-standard deployments.
-->
<RuleGroup name="NetworkConnect-DNP3" groupRelation="or">
  <NetworkConnect onmatch="include">
    <DestinationPort name="technique_id=T0830|T0855,technique=Adversary-in-the-Middle,detection=Process connecting to DNP3 port 20000" condition="is">20000</DestinationPort>
  </NetworkConnect>
</RuleGroup>
